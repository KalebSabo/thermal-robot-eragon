/*
 * Copy this file to secrets.h and fill in your network details.
 * secrets.h is gitignored — do not commit real credentials.
 *
 * On the Pi, install Mosquitto and note its LAN IP (hostname -I).
 */
#pragma once

#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Raspberry Pi running the Mosquitto broker (LAN IP or hostname)
#define MQTT_BROKER   "192.168.1.100"
#define MQTT_PORT     1883

// Leave empty if the broker has no auth (default Mosquitto local setup)
#define MQTT_USER     ""
#define MQTT_PASSWORD ""
